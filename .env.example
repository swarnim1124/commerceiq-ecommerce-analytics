# Copy to .env and edit. Never commit .env.
# Google Cloud project that BigQuery bills queries to (NOT the public dataset's project).
GA4_GCP_PROJECT_ID=your-gcp-project-id
# Dataset in your project where the pipeline writes tables. Created if missing.
GA4_BQ_DATASET=ga4_ecommerce_analysis
# BigQuery location. The public GA4 sample lives in the US multi-region.
GA4_BQ_LOCATION=US
# Optional overrides
# GA4_SOURCE_TABLE=bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*
# GA4_START_DATE=20201101
# GA4_END_DATE=20210131
